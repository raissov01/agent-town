# Relay мекенжайы және ортақ құпия (relay-дегі BRIDGE_TOKEN-мен бірдей)
RELAY_URL=https://town.example.com
BRIDGE_TOKEN=change-me-openssl-rand-hex-32
# Міндетті емес:
# RELAY_IP=1.2.3.4          # DNS істемей қалса, осы IP-ге қосылады
# DAILY_BUDGET=120000       # агенттің күндік output токен бюджеті (= энергия)
# WINDOW_H=8                # соңғы N сағатта белсенді болған сессиялар көрінеді
# ALLOWED_ROOT=/home/you    # командалар тек осы папканың ішінде орындалады
# CLAUDE_BIN=claude
# CODEX_BIN=codex
